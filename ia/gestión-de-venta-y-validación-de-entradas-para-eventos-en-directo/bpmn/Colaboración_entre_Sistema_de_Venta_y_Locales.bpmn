<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN Expert Modeler"
                  exporterVersion="1.0">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Sistema" name="Sistema de Venta de Entradas" processRef="Process_Sistema" />
    <bpmn:participant id="Participant_Local" name="Local" processRef="Process_Local" />
    <bpmn:messageFlow id="MessageFlow_1" name="Datos de entrada (QR, tipo, evento)" sourceRef="Task_EnviarDatos" targetRef="StartEvent_RecibirDatos" />
    <bpmn:messageFlow id="MessageFlow_2" name="Confirmación de validación" sourceRef="Task_EnviarConfirmacion" targetRef="IntermediateCatchEvent_EsperaValidacion" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Sistema" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Venta" name="Entrada vendida">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_EnviarDatos" name="Enviar datos de entrada (QR, tipo, evento) al Local">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_EsperaValidacion" name="Recibir confirmación de validación">
      <bpmn:messageEventDefinition id="MessageEventDef_Catch1" />
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Actualizar" name="Actualizar estado de entrada en sistema central">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Sincronizado1" name="Proceso sincronizado">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Venta" targetRef="Task_EnviarDatos" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_EnviarDatos" targetRef="IntermediateCatchEvent_EsperaValidacion" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="IntermediateCatchEvent_EsperaValidacion" targetRef="Task_Actualizar" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Actualizar" targetRef="EndEvent_Sincronizado1" />
  </bpmn:process>

  <bpmn:process id="Process_Local" isExecutable="false">
    <bpmn:startEvent id="StartEvent_RecibirDatos" name="Recibir datos de entrada">
      <bpmn:messageEventDefinition id="MessageEventDef_Start1" />
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Almacenar" name="Almacenar entrada en base de datos local">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Validar" name="Validar entrada">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EnviarConfirmacion" name="Enviar confirmación de validación al Sistema de Venta">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Sincronizado2" name="Proceso sincronizado">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="StartEvent_RecibirDatos" targetRef="Task_Almacenar" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Almacenar" targetRef="Task_Validar" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Validar" targetRef="Task_EnviarConfirmacion" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_EnviarConfirmacion" targetRef="EndEvent_Sincronizado2" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="BPMNShape_Participant_Sistema" bpmnElement="Participant_Sistema" isHorizontal="true">
        <dc:Bounds x="160" y="50" width="1100" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Participant_Local" bpmnElement="Participant_Local" isHorizontal="true">
        <dc:Bounds x="160" y="380" width="1100" height="260" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_StartEvent_Venta" bpmnElement="StartEvent_Venta">
        <dc:Bounds x="250" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_EnviarDatos" bpmnElement="Task_EnviarDatos">
        <dc:Bounds x="380" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_IntermediateCatchEvent_EsperaValidacion" bpmnElement="IntermediateCatchEvent_EsperaValidacion">
        <dc:Bounds x="580" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_Actualizar" bpmnElement="Task_Actualizar">
        <dc:Bounds x="720" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_EndEvent_Sincronizado1" bpmnElement="EndEvent_Sincronizado1">
        <dc:Bounds x="930" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_StartEvent_RecibirDatos" bpmnElement="StartEvent_RecibirDatos">
        <dc:Bounds x="250" y="492" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_Almacenar" bpmnElement="Task_Almacenar">
        <dc:Bounds x="360" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_Validar" bpmnElement="Task_Validar">
        <dc:Bounds x="540" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_EnviarConfirmacion" bpmnElement="Task_EnviarConfirmacion">
        <dc:Bounds x="720" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_EndEvent_Sincronizado2" bpmnElement="EndEvent_Sincronizado2">
        <dc:Bounds x="930" y="492" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="286" y="180" />
        <di:waypoint x="380" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="480" y="180" />
        <di:waypoint x="580" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="616" y="180" />
        <di:waypoint x="720" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="820" y="180" />
        <di:waypoint x="930" y="180" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="286" y="510" />
        <di:waypoint x="360" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="460" y="510" />
        <di:waypoint x="540" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="640" y="510" />
        <di:waypoint x="720" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="820" y="510" />
        <di:waypoint x="930" y="510" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_MessageFlow_1" bpmnElement="MessageFlow_1">
        <di:waypoint x="430" y="220" />
        <di:waypoint x="430" y="345" />
        <di:waypoint x="268" y="345" />
        <di:waypoint x="268" y="492" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_MessageFlow_2" bpmnElement="MessageFlow_2">
        <di:waypoint x="770" y="470" />
        <di:waypoint x="770" y="345" />
        <di:waypoint x="598" y="345" />
        <di:waypoint x="598" y="198" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>