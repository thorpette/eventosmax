<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Cliente" name="Cliente" />
    <bpmn:participant id="Participant_Local" name="Local" processRef="Process_1" />
    <bpmn:messageFlow id="MessageFlow_1" name="Solicitar entrada" sourceRef="Task_1" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="MessageFlow_2" name="Proporcionar código QR" sourceRef="Participant_Cliente" targetRef="Task_QR" />
    <bpmn:messageFlow id="MessageFlow_3" name="Proporcionar señal Bluetooth" sourceRef="Participant_Cliente" targetRef="Task_BT" />
    <bpmn:messageFlow id="MessageFlow_4" name="Notificar denegación" sourceRef="Task_Denegar" targetRef="Participant_Cliente" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Cliente llega al punto de acceso">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_1" name="Solicitar entrada al cliente">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:inclusiveGateway id="InclusiveGateway_1" name="Seleccionar método de validación">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:serviceTask id="Task_QR" name="Validar entrada por código QR">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_BT" name="Validar entrada por Bluetooth">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:inclusiveGateway id="InclusiveGateway_2" name="Esperar validaciones">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="¿Entrada válida?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Registrar" name="Registrar acceso en el sistema y actualizar estado de entrada">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_Denegar" name="Denegar acceso y notificar al cliente">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_1" name="Proceso de acceso finalizado">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="InclusiveGateway_1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="InclusiveGateway_1" targetRef="Task_QR" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="InclusiveGateway_1" targetRef="Task_BT" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_QR" targetRef="InclusiveGateway_2" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_BT" targetRef="InclusiveGateway_2" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="InclusiveGateway_2" targetRef="ExclusiveGateway_1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="ExclusiveGateway_1" targetRef="Task_Registrar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entradaValida == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_Denegar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entradaValida == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Registrar" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Denegar" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <!-- Participant shapes -->
      <bpmndi:BPMNShape id="Participant_Cliente_di" bpmnElement="Participant_Cliente" isHorizontal="true">
        <dc:Bounds x="100" y="50" width="1000" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Local_di" bpmnElement="Participant_Local" isHorizontal="true">
        <dc:Bounds x="100" y="300" width="1000" height="400" />
      </bpmndi:BPMNShape>

      <!-- StartEvent_1 -->
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="400" width="36" height="36" />
      </bpmndi:BPMNShape>
      <!-- Task_1 -->
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="280" y="380" width="120" height="80" />
      </bpmndi:BPMNShape>
      <!-- InclusiveGateway_1 -->
      <bpmndi:BPMNShape id="InclusiveGateway_1_di" bpmnElement="InclusiveGateway_1">
        <dc:Bounds x="460" y="395" width="50" height="50" />
      </bpmndi:BPMNShape>
      <!-- Task_QR -->
      <bpmndi:BPMNShape id="Task_QR_di" bpmnElement="Task_QR">
        <dc:Bounds x="580" y="320" width="120" height="80" />
      </bpmndi:BPMNShape>
      <!-- Task_BT -->
      <bpmndi:BPMNShape id="Task_BT_di" bpmnElement="Task_BT">
        <dc:Bounds x="580" y="480" width="120" height="80" />
      </bpmndi:BPMNShape>
      <!-- InclusiveGateway_2 -->
      <bpmndi:BPMNShape id="InclusiveGateway_2_di" bpmnElement="InclusiveGateway_2">
        <dc:Bounds x="760" y="395" width="50" height="50" />
      </bpmndi:BPMNShape>
      <!-- ExclusiveGateway_1 -->
      <bpmndi:BPMNShape id="ExclusiveGateway_1_di" bpmnElement="ExclusiveGateway_1">
        <dc:Bounds x="880" y="395" width="50" height="50" />
      </bpmndi:BPMNShape>
      <!-- Task_Registrar -->
      <bpmndi:BPMNShape id="Task_Registrar_di" bpmnElement="Task_Registrar">
        <dc:Bounds x="1000" y="320" width="120" height="80" />
      </bpmndi:BPMNShape>
      <!-- Task_Denegar -->
      <bpmndi:BPMNShape id="Task_Denegar_di" bpmnElement="Task_Denegar">
        <dc:Bounds x="1000" y="480" width="120" height="80" />
      </bpmndi:BPMNShape>
      <!-- EndEvent_1 -->
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1200" y="400" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Sequence Flows -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="216" y="418" />
        <di:waypoint x="280" y="418" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="400" y="418" />
        <di:waypoint x="460" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="510" y="420" />
        <di:waypoint x="580" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="510" y="420" />
        <di:waypoint x="580" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="700" y="360" />
        <di:waypoint x="760" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="700" y="520" />
        <di:waypoint x="760" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="810" y="420" />
        <di:waypoint x="880" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="930" y="420" />
        <di:waypoint x="1000" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="930" y="420" />
        <di:waypoint x="1000" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1120" y="360" />
        <di:waypoint x="1200" y="418" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1120" y="520" />
        <di:waypoint x="1200" y="418" />
      </bpmndi:BPMNEdge>

      <!-- Message Flows -->
      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <di:waypoint x="340" y="380" />
        <di:waypoint x="340" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_2_di" bpmnElement="MessageFlow_2">
        <di:waypoint x="600" y="250" />
        <di:waypoint x="600" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_3_di" bpmnElement="MessageFlow_3">
        <di:waypoint x="650" y="250" />
        <di:waypoint x="650" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_4_di" bpmnElement="MessageFlow_4">
        <di:waypoint x="1060" y="480" />
        <di:waypoint x="1060" y="250" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>