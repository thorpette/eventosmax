        <di:waypoint x="430" y="218" />
        <di:waypoint x="505" y="218" />
        <di:waypoint x="505" y="518" />
        <di:waypoint x="580" y="518" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
