        <di:waypoint x="505" y="318" />
        <di:waypoint x="580" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="430" y="218" />
        <di:waypoint x="505" y="218" />
        <di:waypoint x="505" y="418" />
        <di:waypoint x="580" y="418" />
      </bpmndi:BPMNEdge>
