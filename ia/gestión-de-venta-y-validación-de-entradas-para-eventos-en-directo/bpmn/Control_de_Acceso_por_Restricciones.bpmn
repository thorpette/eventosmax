<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Sistema de Control de Acceso" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Entrada validada exitosamente">
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_1" name="Obtener datos del cliente y entrada" />
    <bpmn:exclusiveGateway id="Gateway_1" name="¿Evento es para mayores de edad?" />
    <bpmn:userTask id="Task_2" name="Solicitar documento de identidad" />
    <bpmn:serviceTask id="Task_3" name="Verificar edad del cliente" />
    <bpmn:exclusiveGateway id="Gateway_2" name="¿Verificación de edad exitosa?" />
    <bpmn:userTask id="Task_4" name="Denegar acceso por restricción de edad" />
    <bpmn:endEvent id="EndEvent_1" name="Acceso denegado">
      <bpmn:messageEventDefinition id="MessageEventDefinition_2" messageRef="Message_2" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_3" name="¿Tipo de entrada es VIP?" />
    <bpmn:serviceTask id="Task_5" name="Dirigir a acceso VIP especial" />
    <bpmn:serviceTask id="Task_6" name="Dirigir a acceso general" />
    <bpmn:serviceTask id="Task_7" name="Permitir acceso al evento" />
    <bpmn:endEvent id="EndEvent_2" name="Acceso permitido">
      <bpmn:messageEventDefinition id="MessageEventDefinition_3" messageRef="Message_3" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_3" name="Sí" sourceRef="Gateway_1" targetRef="Task_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">esParaMayores</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" name="No" sourceRef="Gateway_1" targetRef="Gateway_3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">not esParaMayores</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_3" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_7" name="No (falla)" sourceRef="Gateway_2" targetRef="Task_4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">not edadVerificada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" name="Sí (éxito)" sourceRef="Gateway_2" targetRef="Gateway_3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">edadVerificada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_4" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_10" name="Sí (VIP)" sourceRef="Gateway_3" targetRef="Task_5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">esVIP</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="No (General)" sourceRef="Gateway_3" targetRef="Task_6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">not esVIP</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_5" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_7" targetRef="EndEvent_2" />
  </bpmn:process>
