# PassLive API - variables de entorno
PORT=4000
NODE_ENV=development
DATABASE_PATH=./data/passlive.db
# Clave simple de acceso para el panel/administración (supuesto: BPMN no define auth)
API_KEY=passlive-dev-key
# URL base del "Sistema de Venta" usada por los locales para confirmar validaciones (MessageFlow_2)
SALES_API_URL=http://localhost:4000
# Edad mínima por defecto cuando el evento no define restricción (SUPUESTO)
DEFAULT_MIN_AGE=18
